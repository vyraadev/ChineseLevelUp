// Convert compact rows into objects; all questions have four choices and a single answer.
const banksFinal = banks.map((bank, li) => bank.map((r, i) => {
 const originalChoices = r.slice(2,6);
 const correctChoice = originalChoices[r[6]];
 // Shuffle choices so the correct answer is not always in the same position.
 const choices = [...originalChoices].sort(() => Math.random() - 0.5);
 return {
  id:`${li+1}-${i+1}`, topic:r[1], q:r[0],
  choices, answer:choices.indexOf(correctChoice),
  explanation:`The best answer is “${correctChoice}.” This follows from the core ${r[1].toLowerCase()} concept being tested.`
 };
}));
let mode="quiz", level=0, index=0, score=0, answers=[], completed=new Set(), unlocked=10, answered=false;
const activeBanks=()=>mode==="exam"?examBanksFinal:banksFinal;
const $=id=>document.getElementById(id);
let timerInterval=null, timeLeft=10;
function stopTimer(){if(timerInterval!==null){clearInterval(timerInterval);timerInterval=null;}}
function displayTimer(){
 const el=$("timer"), box=$("timerStat");
 if(mode==="exam"){
  el.textContent=`${Math.floor(timeLeft/60).toString().padStart(2,"0")}:${(timeLeft%60).toString().padStart(2,"0")}`;
  $("timerUnit").textContent="";
  box.classList.toggle("urgent",timeLeft<=300);
 }else{
  el.textContent=timeLeft;$("timerUnit").textContent="s";box.classList.toggle("urgent",timeLeft<=3);
 }
}
function startTimer(){
 if(mode==="exam"){
  if(timerInterval!==null)return;
  timeLeft=1800;displayTimer();
  timerInterval=setInterval(()=>{
   if($("game").classList.contains("hidden")){stopTimer();return;}
   timeLeft=Math.max(0,timeLeft-1);displayTimer();
   if(timeLeft===0){stopTimer();answers=answers.map(a=>a===null?-1:a);finishLevel(true);}
  },1000);
  return;
 }
 stopTimer();timeLeft=10;displayTimer();
 timerInterval=setInterval(()=>{
  if($("game").classList.contains("hidden")||answered){stopTimer();return;}
  timeLeft=Math.max(0,timeLeft-1);displayTimer();
  if(timeLeft===0){
   stopTimer();
   if(answers[index]===null){answers[index]=-1;renderQuestion();}
   if(index<activeBanks()[level].length-1){$("nextBtn").disabled=false;$("liveScore").textContent="Time is up! Moving to the next question…";setTimeout(()=>{if(!$("game").classList.contains("hidden")&&index<activeBanks()[level].length-1){index++;renderQuestion();}},650);}
   else {setTimeout(()=>{if(!$("game").classList.contains("hidden")&&index===activeBanks()[level].length-1)finishLevel();},650);}
  }
 },1000);
}
function renderLevels(){
 $("levels").innerHTML="";
 titles.forEach((title,i)=>{
  const b=document.createElement("button");b.className="level";b.disabled=i+1>unlocked;
  const done=completed.has(i);
  b.innerHTML=`${done?'<span class="check">✓</span>':''}<div class="num">${String(i+1).padStart(2,"0")}</div><div class="name">${title}</div><small>${descriptions[i]} · 15 questions</small>`;
  b.addEventListener("click",()=>startLevel(i));$("levels").appendChild(b);
 });
 $("modeNote").textContent=mode==="quiz"?"Quiz mode gives instant feedback and updates your score as you answer.":"Exam mode gives you 30 minutes for each level. Answers and score stay hidden until the level ends.";
}
document.querySelectorAll(".mode").forEach(b=>b.addEventListener("click",()=>{
 mode=b.dataset.mode;document.querySelectorAll(".mode").forEach(x=>x.classList.toggle("active",x===b));renderLevels();
}));
function startLevel(i){stopTimer();level=i;index=0;score=0;answers=Array(activeBanks()[level].length).fill(null);answered=false;$("home").classList.add("hidden");$("results").classList.add("hidden");$("game").classList.remove("hidden");renderQuestion();}
function renderQuestion(){
 const q=activeBanks()[level][index];answered=answers[index]!==null;
 $("levelLabel").textContent=`LEVEL ${level+1} · ${mode.toUpperCase()} MODE`;$("gameTitle").textContent=titles[level];
 $("qCount").textContent=`${index+1}/${activeBanks()[level].length}`;$("score").textContent=score;
 $("scoreStat").classList.toggle("hidden",mode==="exam");
 $("progressFill").style.width=`${((index+(answered?1:0))/activeBanks()[level].length)*100}%`;
 $("topicLabel").textContent=q.topic.toUpperCase();$("question").textContent=q.q;
 $("options").innerHTML="";
 q.choices.forEach((choice,j)=>{
  const b=document.createElement("button");b.className="option";b.innerHTML=`<span class="letter">${"ABCD"[j]}</span><span></span>`;b.lastElementChild.textContent=choice;
  if(answers[index]===j)b.classList.add("selected");
  if(answered){b.disabled=true;if(mode==="quiz"){if(j===q.answer)b.classList.add("correct");if(answers[index]===j&&j!==q.answer)b.classList.add("wrong");}}
  b.addEventListener("click",()=>selectAnswer(j));$("options").appendChild(b);
 });
 $("feedback").classList.add("hidden");$("feedback").classList.remove("good","bad");
 if(answered&&mode==="quiz")showFeedback(q,answers[index]===q.answer);
 $("nextBtn").disabled=!answered;$("nextBtn").textContent=index===activeBanks()[level].length-1?"Finish level ✓":"Next question →";
 $("liveScore").textContent=mode==="quiz"?`Score so far: ${score}/${answers.filter(a=>a!==null).length}`:"Your result will be revealed when the level ends.";
 $("timerStat").classList.remove("hidden");
 if(mode==="quiz"&&!answered)startTimer();else if(mode==="exam")startTimer();else stopTimer();
}
function selectAnswer(choice){
 if(answers[index]!==null)return;if(mode==="quiz")stopTimer();const q=activeBanks()[level][index];answers[index]=choice;if(choice===q.answer)score++;
 renderQuestion();
 if(mode==="quiz")showFeedback(q,choice===q.answer);
 $("nextBtn").disabled=false;
}
function showFeedback(q,correct){const el=$("feedback");el.classList.remove("hidden");el.classList.add(correct?"good":"bad");el.textContent=(correct?"Correct. ":"Not quite. ")+q.explanation;}
$("nextBtn").addEventListener("click",()=>{if(answers[index]===null)return;if(index<activeBanks()[level].length-1){index++;renderQuestion();}else finishLevel();});
$("quitBtn").addEventListener("click",()=>{stopTimer();$("game").classList.add("hidden");$("home").classList.remove("hidden");renderLevels();});
function finishLevel(timeExpired=false){
 stopTimer();completed.add(level);unlocked=Math.max(unlocked,Math.min(10,level+2));
 const total=activeBanks()[level].length, pct=Math.round(score/total*100);
 $("game").classList.add("hidden");$("results").classList.remove("hidden");
 let review=activeBanks()[level].map((q,i)=>{const picked=answers[i],ok=picked===q.answer;return `<div class="review-item"><strong>${i+1}. ${escapeHtml(q.q)}</strong><div class="${ok?'right':'wrongtext'}">${ok?'Correct':'Incorrect'} · Your answer: ${picked===null||picked===-1?'Not answered (time expired)':escapeHtml(q.choices[picked])}</div><div>Answer: ${escapeHtml(q.choices[q.answer])}</div></div>`}).join("");
 $("results").innerHTML=`<div class="result"><div class="eyebrow">Level ${level+1} complete</div><div class="score-ring" style="--score:${pct*3.6}deg"><div><strong>${pct}%</strong><span style="color:var(--muted);font-size:.8rem">${score}/${total} correct</span></div></div><h2>${pct>=80?"Excellent work!":pct>=60?"Good progress!":"Keep practicing!"}</h2><p>${mode==="exam"?(timeExpired?"Time expired. Your exam result is now revealed.":"Your exam result is now revealed."):"Your level result is ready."} ${level<9?"Complete the next level to keep progressing.":"You reached the final level!"}</p><div style="display:flex;gap:10px;justify-content:center;flex-wrap:wrap;margin-top:18px"><button id="backLevels" class="btn secondary">Back to levels</button>${level<9?'<button id="nextLevel" class="btn">Next level →</button>':''}<button id="retry" class="btn secondary">Retry level</button></div></div><div class="review"><h3>Answer review</h3>${review}</div>`;
 $("backLevels").addEventListener("click",()=>{$("results").classList.add("hidden");$("home").classList.remove("hidden");renderLevels();window.scrollTo({top:0,behavior:"smooth"});});
 if($("nextLevel"))$("nextLevel").addEventListener("click",()=>startLevel(level+1));
 $("retry").addEventListener("click",()=>startLevel(level));
 window.scrollTo({top:0,behavior:"smooth"});
}
function escapeHtml(s){return String(s).replace(/[&<>"']/g,c=>({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"}[c]));}
renderLevels();
</script>
